# Carsai Mozambique — Environment Variables
#
# Firebase CLIENT config is hardcoded in src/lib/client-config.ts
# (it's public anyway — embedded in the client bundle).
#
# Firebase ADMIN credentials are server-side only.
# For CI: set these as GitHub Secrets.
# For local dev: set them in .env.local (gitignored).
#
# NEVER commit secrets to this file.

# ─── Firebase Admin SDK (server-side only) ───
# Required for API routes and seed scripts.
# Set these in .env.local or as GitHub Secrets.

# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=

# ─── Optional: API URL for Capacitor mobile app ───
# Set this to your deployed server URL for mobile app API calls.
# Leave empty for web (relative paths work).

# NEXT_PUBLIC_API_URL=
