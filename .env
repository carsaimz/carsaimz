# =============================================================================
# Carsai Mozambique - Environment Configuration
# =============================================================================
# 
# DATABASE: SQLite (local, always works — no external server needed)
# To switch to MySQL for production:
#   1. Install MySQL/MariaDB on your server
#   2. Change prisma/schema.prisma: provider = "mysql"
#   3. Change DATABASE_URL: mysql://user:password@localhost:3306/carsaimz
#   4. Run: bun run db:push
# 
# SUPABASE: Optional — set keys if you want to use Supabase Auth on top
# of local auth. Without these, auth uses local SQLite database.
# =============================================================================

# ─── Database (SQLite — always works locally) ───

DATABASE_URL=file:./db/carsaimz.db

# ─── Supabase (optional — for cloud auth if needed later) ───

NEXT_PUBLIC_SUPABASE_URL=https://kngwnzvotefivjmaleup.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── App Version ───

NEXT_PUBLIC_APP_VERSION=0.2.1
NEXT_PUBLIC_APP_BUILD=2

# ─── API URL (for Capacitor mobile app) ───

NEXT_PUBLIC_API_URL=
