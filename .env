# ─── Google Sign-In (Capacitor Android) ───
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=117955101988984767727.apps.googleusercontent.com

# ─── Firebase Admin SDK (server-side only) ───
# PROJECT_ID and CLIENT_EMAIL have hardcoded fallbacks in src/lib/firebase-admin.ts
# Only the PRIVATE_KEY needs to be set here.
# Get it from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# IMPORTANT: Never commit this key to source code! Google will revoke it.
FIREBASE_ADMIN_PRIVATE_KEY=

