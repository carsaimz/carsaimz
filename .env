# =============================================================================
# Carsai Mozambique - Environment Configuration
# =============================================================================
#
# IMPORTANT: You MUST fill in the actual values below before deploying.
# These are required for authentication and database access.
#
# How to get Supabase values:
#   1. Go to https://supabase.com/dashboard
#   2. Select your project (kngwnzvotefivjmaleup)
#   3. Navigate to Settings → API
#   4. Copy the "anon / public" key → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   5. Copy the "service_role / secret" key → SUPABASE_SERVICE_ROLE_KEY (NEVER expose client-side!)
#   6. Navigate to Settings → Database
#   7. Copy the "Session mode" Pooler connection string → DATABASE_URL
#
# ⚠️ SUPABASE_SERVICE_ROLE_KEY is a SECRET — never put it in NEXT_PUBLIC_ vars
#    or commit it to the repository. Use GitHub Actions secrets for CI.
# =============================================================================

# ─── Supabase (REQUIRED) ───

# Public anon key — safe for client-side code (starts with 'eyJ...')
NEXT_PUBLIC_SUPABASE_URL=https://kngwnzvotefivjmaleup.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret service role key — SERVER ONLY, never expose to client-side
# This is required for API routes to manage auth and user profiles
SUPABASE_SERVICE_ROLE_KEY=

# ─── Database (Prisma — for non-auth API routes) ───
#
# IMPORTANT: Use the Supabase SESSION POOLER URL, NOT the direct connection.
# Direct: db.kngwnzvotefivjmaleup.supabase.co:5432 — BLOCKED by Supabase
# Pooler: aws-0-eu-central-1.pooler.supabase.com:5432 — Works everywhere
#
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Get this from: Supabase Dashboard → Settings → Database → Connection string → Session mode
DATABASE_URL=

# ─── App Version ───

NEXT_PUBLIC_APP_VERSION=0.2.1
NEXT_PUBLIC_APP_BUILD=2

# ─── API URL (for Capacitor mobile app) ───
# When running as a mobile app, this points to the backend server
NEXT_PUBLIC_API_URL=
