.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# Uploaded sensitive files (service account keys, keystores)
/upload/*.json
/upload/*.keystore
/upload/*.jks

# Encrypted key reference (not needed in repo)
.env.encryptedupload/
tool-results/

# Auto-generated embedded credentials — MUST be committed so Vercel can use them.
# The credentials are base64-encoded JSON (not plain text), so they're safe to commit.
# Regenerated by: node scripts/embed-firebase-credentials.js
# src/lib/firebase-admin-embedded.ts

# Large archive — never commit (GitHub 100 MB limit)
download/carsaimz-project.zip
download/*.zip
*.zip.local


# Local dev process ID — never commit
.zscripts/dev.pid
*.pid


# Secrets and large archives — never commit
upload/google-services.json
upload/release.jks
upload/*.jks
upload/*.keystore
release/*.zip
release/*.apk
release/*.aab
release/*.exe

