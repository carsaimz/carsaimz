rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Setup mode: allow writes when the app hasn't been set up yet.
    // This is essential for the /setup wizard to seed initial data
    // (roles, permissions, categories, etc.) before the admin exists.
    // Once setup is complete, this returns false and normal auth rules apply.
    //
    // IMPORTANT: Firestore rules evaluate both sides of || (no short-circuit).
    // We must guard get() with exists() to avoid null.data errors.
    function isSetupMode() {
      return !exists(/databases/$(database)/documents/settings/app) ||
             (exists(/databases/$(database)/documents/settings/app) &&
              !get(/databases/$(database)/documents/settings/app).data.setupComplete);
    }

    // Authenticated OR in setup mode — used for seed collections
    function canWrite() {
      return isAuthenticated() || isSetupMode();
    }

    // ── Users collection ──
    // Anyone authenticated can read user profiles
    // Users can create/update their own profile
    // During setup, allow creating the admin user profile
    match /users/{userId} {
      allow read: if isAuthenticated() || isSetupMode();
      allow create: if isOwner(userId) || isSetupMode();
      allow update: if isOwner(userId);
      allow delete: if false; // Only via Admin SDK
    }

    // ── Roles & Permissions ──
    // Allow reads so the seed check works even before auth
    // During setup, allow seeding roles/permissions
    match /roles/{roleId} {
      allow read: if true;
      allow write: if canWrite();
    }

    match /permissions/{permId} {
      allow read: if true;
      allow write: if canWrite();
    }

    match /role_permissions/{rpId} {
      allow read: if true;
      allow write: if canWrite();
    }

    // ── Settings ──
    // Allow reads so the seed check works even before auth
    // During setup, allow writing initial settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if canWrite();
    }

    // ── Blog: posts, categories, tags, comments ──
    match /posts/{postId} {
      allow read: if true;
      allow write: if canWrite();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if canWrite();
    }

    match /tags/{tagId} {
      allow read: if true;
      allow write: if canWrite();
    }

    match /post_tags/{ptId} {
      allow read: if true;
      allow write: if canWrite();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ── Forum ──
    match /forum_categories/{catId} {
      allow read: if true;
      allow write: if canWrite();
    }

    match /forum_topics/{topicId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /forum_posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /forum_likes/{likeId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ── Services & Projects ──
    match /services/{serviceId} {
      allow read: if true;
      allow write: if canWrite();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if canWrite();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if canWrite();
    }

    // ── Business: quotes, proposals, payments, invoices ──
    match /quotes/{quoteId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /proposals/{proposalId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /invoices/{invoiceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /invoice_items/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── Affiliate ──
    match /affiliate_clicks/{clickId} {
      allow read: if isAuthenticated();
      allow create: if true;
      allow write: if isAuthenticated();
    }

    match /affiliate_commissions/{commissionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── Notifications ──
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── Support ──
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /ticket_replies/{replyId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── File attachments ──
    match /file_attachments/{fileId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── AI providers ──
    match /ai_providers/{providerId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── Audit logs ──
    match /logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only via Admin SDK
    }

    // ── Pages ──
    match /pages/{pageId} {
      allow read: if true;
      allow write: if canWrite();
    }

    // ── Newsletter subscribers ──
    match /subscribers/{subId} {
      allow read: if isAuthenticated();
      allow create: if true; // Allow anonymous subscription
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
  }
}
