// Carsai Mozambique - Database Schema
// Prisma with MySQL (infinityfree remote database)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// === Core User & Auth ===

model User {
  id            String    @id @default(cuid()) @db.VarChar(30)
  email         String    @unique @db.VarChar(255)
  name          String?   @db.VarChar(255)
  avatar        String?   @db.LongText     // base64 data URI or URL — can be very large
  phone         String?   @db.VarChar(50)
  company       String?   @db.VarChar(255)
  bio           String?   @db.Text
  address       String?   @db.Text
  passwordHash  String?   @db.VarChar(255)
  roleId        String?   @db.VarChar(30)
  role          Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  posts              Post[]
  comments           Comment[]
  forumTopics        ForumTopic[]
  forumPosts         ForumPost[]
  quotes             Quote[]
  payments           Payment[]
  notifications      Notification[]
  supportTickets     SupportTicket[]
  ticketReplies      TicketReply[]
  affiliateClicks    AffiliateClick[]
  affiliateCommissions AffiliateCommission[]

  @@map("users")
}

model Role {
  id          String    @id @default(cuid()) @db.VarChar(30)
  name        String    @unique @db.VarChar(50)
  description String?   @db.Text
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("roles")
}

model Permission {
  id              String          @id @default(cuid()) @db.VarChar(30)
  name            String          @unique @db.VarChar(100)
  description     String?         @db.Text
  rolePermissions RolePermission[]
  createdAt       DateTime        @default(now())

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid()) @db.VarChar(30)
  roleId       String     @db.VarChar(30)
  permissionId String     @db.VarChar(30)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// === Public Content ===

model Page {
  id          String    @id @default(cuid()) @db.VarChar(30)
  slug        String    @unique @db.VarChar(255)
  title       String    @db.VarChar(255)
  content     String?   @db.LongText
  isPublished Boolean   @default(true)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("pages")
}

model Service {
  id              String    @id @default(cuid()) @db.VarChar(30)
  slug            String    @unique @db.VarChar(255)
  title           String    @db.VarChar(255)
  titleI18n       String?   @db.LongText    // JSON object with translations
  description     String?   @db.Text
  descriptionI18n String?   @db.LongText    // JSON object with translations
  icon            String?   @db.LongText    // base64 data URI or icon name
  basePrice       Float?
  isFeatured      Boolean   @default(false)
  isPublished     Boolean   @default(true)
  order           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("services")
}

model Project {
  id              String    @id @default(cuid()) @db.VarChar(30)
  slug            String    @unique @db.VarChar(255)
  title           String    @db.VarChar(255)
  titleI18n       String?   @db.LongText    // JSON object with translations
  description     String?   @db.Text
  descriptionI18n String?   @db.LongText    // JSON object with translations
  client          String?   @db.VarChar(255)
  technologies    String?   @db.Text
  demoUrl         String?   @db.VarChar(500)
  images          String?   @db.LongText    // JSON array of base64 data URIs
  isPublished     Boolean   @default(true)
  isFeatured      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("projects")
}

model Testimonial {
  id          String    @id @default(cuid()) @db.VarChar(30)
  name        String    @db.VarChar(255)
  company     String?   @db.VarChar(255)
  content     String    @db.Text
  contentI18n String?   @db.LongText    // JSON object with translations
  rating      Int       @default(5)
  avatar      String?   @db.LongText    // base64 data URI for avatar image
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@map("testimonials")
}

// === Blog ===

model Category {
  id        String   @id @default(cuid()) @db.VarChar(30)
  name      String   @unique @db.VarChar(255)
  slug      String   @unique @db.VarChar(255)
  posts     Post[]
  createdAt DateTime @default(now())

  @@map("categories")
}

model Tag {
  id        String   @id @default(cuid()) @db.VarChar(30)
  name      String   @unique @db.VarChar(255)
  slug      String   @unique @db.VarChar(255)
  posts     PostTag[]
  createdAt DateTime @default(now())

  @@map("tags")
}

model Post {
  id            String    @id @default(cuid()) @db.VarChar(30)
  title         String    @db.VarChar(255)
  titleI18n     String?   @db.LongText    // JSON object with translations
  slug          String    @unique @db.VarChar(255)
  excerpt       String?   @db.Text
  excerptI18n   String?   @db.LongText    // JSON object with translations
  content       String?   @db.LongText
  contentI18n   String?   @db.LongText    // JSON object with translations
  featuredImage String?   @db.LongText    // base64 data URI
  published     Boolean   @default(false)
  authorId      String    @db.VarChar(30)
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  categoryId    String?   @db.VarChar(30)
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  comments      Comment[]
  tags          PostTag[]

  @@map("posts")
}

model PostTag {
  id     String @id @default(cuid()) @db.VarChar(30)
  postId String @db.VarChar(30)
  tagId  String @db.VarChar(30)
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@map("post_tags")
}

model Comment {
  id        String   @id @default(cuid()) @db.VarChar(30)
  content   String   @db.Text
  postId    String   @db.VarChar(30)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String   @db.VarChar(30)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())

  @@map("comments")
}

model Subscriber {
  id        String   @id @default(cuid()) @db.VarChar(30)
  email     String   @unique @db.VarChar(255)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("subscribers")
}

// === Forum ===

model ForumCategory {
  id             String       @id @default(cuid()) @db.VarChar(30)
  name           String       @db.VarChar(255)
  nameI18n       String?      @db.LongText    // JSON object with translations
  slug           String       @unique @db.VarChar(255)
  description    String?      @db.Text
  descriptionI18n String?     @db.LongText    // JSON object with translations
  order          Int          @default(0)
  topics         ForumTopic[]
  createdAt      DateTime     @default(now())

  @@map("forum_categories")
}

model ForumTopic {
  id           String        @id @default(cuid()) @db.VarChar(30)
  title        String        @db.VarChar(255)
  titleI18n    String?       @db.LongText    // JSON object with translations
  slug         String        @unique @db.VarChar(255)
  content      String?       @db.LongText
  contentI18n  String?       @db.LongText    // JSON object with translations
  categoryId   String        @db.VarChar(30)
  category     ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  authorId     String        @db.VarChar(30)
  author       User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isPinned     Boolean       @default(false)
  isLocked     Boolean       @default(false)
  isResolved   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  replies      ForumPost[]
  likes        ForumLike[]

  @@map("forum_topics")
}

model ForumPost {
  id        String      @id @default(cuid()) @db.VarChar(30)
  content   String      @db.LongText
  topicId   String      @db.VarChar(30)
  topic     ForumTopic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  authorId  String      @db.VarChar(30)
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@map("forum_posts")
}

model ForumLike {
  id      String     @id @default(cuid()) @db.VarChar(30)
  topicId String     @db.VarChar(30)
  topic   ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userId  String     @db.VarChar(30)
  createdAt DateTime @default(now())

  @@unique([topicId, userId])
  @@map("forum_likes")
}

// === Financial ===

model Quote {
  id          String    @id @default(cuid()) @db.VarChar(30)
  title       String    @db.VarChar(255)
  description String?   @db.Text
  attachments String?   @db.LongText    // JSON array of base64 data URIs
  status      String    @default("pending") @db.VarChar(50)
  userId      String    @db.VarChar(30)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  proposals   Proposal[]

  @@map("quotes")
}

model Proposal {
  id          String    @id @default(cuid()) @db.VarChar(30)
  quoteId     String    @db.VarChar(30)
  quote       Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  title       String    @db.VarChar(255)
  description String?   @db.Text
  items       String?   @db.LongText    // JSON array of line items
  totalAmount Float?
  validUntil  DateTime?
  status      String    @default("sent") @db.VarChar(50)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  payments    Payment[]
  invoices    Invoice[]

  @@map("proposals")
}

model Payment {
  id            String     @id @default(cuid()) @db.VarChar(30)
  proposalId    String?    @db.VarChar(30)
  proposal      Proposal?  @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  userId        String     @db.VarChar(30)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Float
  method        String     @db.VarChar(50)
  status        String     @default("pending") @db.VarChar(50)
  reference     String?    @db.VarChar(255)
  receiptUrl    String?    @db.LongText     // base64 data URI for payment receipt
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("payments")
}

model Invoice {
  id          String       @id @default(cuid()) @db.VarChar(30)
  proposalId  String       @db.VarChar(30)
  proposal    Proposal     @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  number      String       @unique @db.VarChar(50)
  totalAmount Float
  status      String       @default("issued") @db.VarChar(50)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())

  items       InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(cuid()) @db.VarChar(30)
  invoiceId   String   @db.VarChar(30)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String   @db.Text
  quantity    Int      @default(1)
  unitPrice   Float
  total       Float

  @@map("invoice_items")
}

// === Affiliate / Partner ===

model AffiliateClick {
  id        String   @id @default(cuid()) @db.VarChar(30)
  userId    String   @db.VarChar(30)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkCode  String   @db.VarChar(255)
  ip        String?   @db.VarChar(50)
  createdAt DateTime @default(now())

  @@map("affiliate_clicks")
}

model AffiliateCommission {
  id        String   @id @default(cuid()) @db.VarChar(30)
  userId    String   @db.VarChar(30)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  status    String   @default("pending") @db.VarChar(50)
  createdAt DateTime @default(now())

  @@map("affiliate_commissions")
}

// === Notifications ===

model Notification {
  id        String   @id @default(cuid()) @db.VarChar(30)
  userId    String   @db.VarChar(30)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @db.VarChar(255)
  message   String   @db.Text
  type      String   @default("info") @db.VarChar(50)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

// === Support ===

model SupportTicket {
  id        String         @id @default(cuid()) @db.VarChar(30)
  userId    String         @db.VarChar(30)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String         @db.VarChar(255)
  status    String         @default("open") @db.VarChar(50)
  priority  String         @default("medium") @db.VarChar(50)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  replies   TicketReply[]

  @@map("support_tickets")
}

model TicketReply {
  id        String         @id @default(cuid()) @db.VarChar(30)
  ticketId  String         @db.VarChar(30)
  ticket    SupportTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String         @db.VarChar(30)
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String         @db.Text
  createdAt DateTime       @default(now())

  @@map("ticket_replies")
}

// === File Storage (Base64) ===

model FileAttachment {
  id          String   @id @default(cuid()) @db.VarChar(30)
  name        String   @db.VarChar(255)
  mimeType    String   @db.VarChar(100)
  size        Int
  data        String   @db.LongText     // base64 encoded content
  category    String   @db.VarChar(50)
  userId      String?  @db.VarChar(30)
  createdAt   DateTime @default(now())

  @@map("file_attachments")
}

// === Settings ===

model Setting {
  id    String @id @default(cuid()) @db.VarChar(30)
  key   String @unique @db.VarChar(255)
  value String? @db.LongText

  @@map("settings")
}

// === AI Providers (Multi-provider failover) ===

model AiProvider {
  id          String    @id @default(cuid()) @db.VarChar(30)
  name        String    @unique @db.VarChar(50)
  displayName String?   @db.VarChar(255)
  apiKey      String?   @db.VarChar(500)
  baseUrl     String?   @db.VarChar(500)
  model       String?   @db.VarChar(100)
  priority    Int       @default(0)
  isActive    Boolean   @default(true)
  config      String?   @db.LongText     // JSON config
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("ai_providers")
}

// === Logs ===

model Log {
  id        String   @id @default(cuid()) @db.VarChar(30)
  action    String   @db.VarChar(100)
  details   String?  @db.Text
  userId    String?  @db.VarChar(30)
  createdAt DateTime @default(now())

  @@map("logs")
}
